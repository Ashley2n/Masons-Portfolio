# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local preview config
.claude/launch.json

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Impeccable engine binary: the launcher downloads it per OS and checks its SHA-256 (D-27)
/.claude/skills/impeccable/scripts/bin/
